// src/bot/tsconfig.json
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../",
    "outDir": "../../dist",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "playwright"
    ]
  },
  "include": [
    "../bot/**/*.ts",
    "../playwright/**/*.ts",
    "../models.ts",
    "../storage.ts",
    "../summarize.ts"
  ],
  "exclude": [
    "../playwright/**/extentionCaptionScraper.ts",
    "../playwright/**/IncrementalcaptionScraper.ts"
  ]
}