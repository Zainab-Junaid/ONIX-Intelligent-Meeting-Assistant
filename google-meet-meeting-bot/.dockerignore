# ─── Dependencies (re-installed inside the container) ────────────────────
node_modules
**/node_modules

# ─── Build artifacts ─────────────────────────────────────────────────────
dist
**/dist

# ─── Environment & secrets ───────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Git ─────────────────────────────────────────────────────────────────
.git
.gitignore

# ─── IDE / Editor ────────────────────────────────────────────────────────
.vscode
.idea
*.swp
*.swo

# ─── OS files ────────────────────────────────────────────────────────────
Thumbs.db
.DS_Store

# ─── Docker meta (Dockerfiles are referenced via -f, not COPY'd) ────────
docker-compose*
.dockerignore

# ─── Docs ────────────────────────────────────────────────────────────────
README.md
docs

# ─── Test / Coverage ────────────────────────────────────────────────────
tests
__tests__
coverage
.nyc_output
