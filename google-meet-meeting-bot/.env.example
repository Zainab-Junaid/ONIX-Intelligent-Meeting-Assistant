# AI Meeting Assistant - Environment Variables Template
# Copy this file to .env and update the values

# ===========================================
# PostgreSQL Database
# ===========================================
POSTGRES_USER=meetingbot
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=meetingbotpoc

# Connection URL (uses the above variables)
DATABASE_URL=postgresql://meetingbot:your_secure_password_here@postgres:5432/meetingbotpoc

# For local development (outside Docker), use:
# DATABASE_URL=postgresql://meetingbot:your_secure_password_here@localhost:5432/meetingbotpoc

# ===========================================
# MongoDB (Transcript Storage - Source of Truth)
# ===========================================
MONGODB_URI=mongodb://localhost:27017/meeting-transcripts

# ===========================================
# Redis (Caption Buffering & Pub/Sub)
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# External APIs
# ===========================================
# AssemblyAI (for transcription if needed)
ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# OpenAI or other LLM (for summaries)
OPENAI_API_KEY=your_openai_key_here

# ===========================================
# Frontend URL (for email sending)
# ===========================================
FRONTEND_URL=http://localhost:3000

# ===========================================
# Google Meet Bot Settings
# ===========================================
# Path to auth.json on the host machine (for Docker volume mount)
AUTH_JSON_HOST_PATH=/path/to/your/auth.json

# ===========================================
# Firestore (optional - set to 1 to enable)
# ===========================================
ENABLE_FIRESTORE=0
